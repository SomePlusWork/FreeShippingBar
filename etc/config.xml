<?xml version="1.0"?>
<!--
/**
 * SomePlus Free Shipping Bar - Default Configuration
 */
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <someplus_freeshippingbar>
            <general>
                <enabled>1</enabled>
                <threshold>250</threshold>
                <include_tax>0</include_tax>
            </general>
            <display>
                <show_header>1</show_header>
                <show_minicart>1</show_minicart>
                <show_cart>1</show_cart>
                <show_checkout>1</show_checkout>
            </display>
            <design>
                <bar_color>#10b981</bar_color>
                <bg_color>#e5e7eb</bg_color>
                <text_color>#374151</text_color>
                <achieved_color>#059669</achieved_color>
            </design>
            <messages>
                <progress_message><![CDATA[🚚 Add <strong>{{remaining}}</strong> more for free shipping!]]></progress_message>
                <achieved_message><![CDATA[🎉 Congratulations! You've unlocked free shipping!]]></achieved_message>
                <empty_cart_message><![CDATA[🛒 Add items to your cart, free shipping on orders over <strong>{{threshold}}</strong>!]]></empty_cart_message>
            </messages>
        </someplus_freeshippingbar>
    </default>
</config>
